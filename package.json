{
  "name": "markdown-table-formatter",
  "version": "2.0.0",
  "description": "Format markdown tables in files (Rust engine compiled to WebAssembly, no dependencies)",
  "main": "./lib/index.js",
  "files": [
    "lib/"
  ],
  "bin": {
    "markdown-table-formatter": "lib/index.js"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.js",
    "lint:fix": "eslint **/*.js --fix && prettier --write \"./lib/**/*.{js,jsx,json}\" --tab-width 4 --print-width 150",
    "prepack": "npm run build:wasm",
    "pretest": "npm run build:wasm",
    "test": "mocha \"test/**/*.test.js\"",
    "test:coverage": "nyc npm run test",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "test:debug": "env NODE_DEBUG=markdown-table-formatter mocha --reporter spec \"test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvuillam/markdown-table-formatter.git"
  },
  "keywords": [
    "markdown",
    "table",
    "formatter",
    "format",
    "prettify"
  ],
  "author": "Nicolas Vuillamy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nvuillam/markdown-table-formatter/issues"
  },
  "homepage": "https://github.com/nvuillam/markdown-table-formatter#readme",
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.3",
    "eslint": "^9.0.0",
    "mega-linter-runner": "^9.0.0",
    "mocha": "^11.0.0",
    "nyc": "^18.0.0",
    "which": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "mocha": {
    "require": [
      "test/helpers/init.js"
    ],
    "watch-extensions": [
      "js"
    ],
    "recursive": true,
    "reporter": "spec",
    "timeout": "300000"
  },
  "nyc": {
    "include": [
      "lib/**"
    ],
    "extension": [
      ".js"
    ],
    "reporter": [
      "html"
    ],
    "all": true
  }
}
