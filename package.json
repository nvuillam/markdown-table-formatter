{
  "name": "markdown-table-formatter",
  "version": "2.0.0",
  "description": "Format markdown tables in files (Rust engine compiled to WebAssembly, no dependencies)",
  "main": "./lib/index.js",
  "files": [
    "lib/"
  ],
  "bin": {
    "markdown-table-formatter": "lib/index.js"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.js",
    "lint:fix": "eslint --fix && prettier --write \"./lib/**/*.{js,jsx,json}\" --tab-width 4 --print-width 150",
    "prepack": "node scripts/build-wasm.js --if-needed",
    "pretest": "npm run build:wasm",
    "test": "node --test --test-timeout=300000 \"test/**/*.test.js\"",
    "test:coverage": "node --test --test-timeout=300000 --experimental-test-coverage --test-coverage-include=\"lib/**\" \"test/**/*.test.js\"",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "test:debug": "env NODE_DEBUG=markdown-table-formatter node --test --test-timeout=300000 --test-reporter=spec \"test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvuillam/markdown-table-formatter.git"
  },
  "keywords": [
    "markdown",
    "table",
    "formatter",
    "format",
    "prettify"
  ],
  "author": "Nicolas Vuillamy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nvuillam/markdown-table-formatter/issues"
  },
  "homepage": "https://github.com/nvuillam/markdown-table-formatter#readme",
  "devDependencies": {
    "eslint": "^10.14.0"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
